<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hud_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#475569" />

    <!-- Top Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/view_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#00F5FF"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_hud_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CYBERDON AI"
                android:textColor="#00F5FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_hud_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="[READY]"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hud_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FF6B6B"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Stop Speaking Banner (Visible only when Assistant is speaking) -->
    <TextView
        android:id="@+id/btn_stop_speaking"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:background="@drawable/bg_stop_btn"
        android:text="⏹ STOP SPEAKING (Awaaz Roko)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Conversation / Status Display -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="160dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_hud_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CyberDon ready hai. Boliye ya quick chips use karein."
            android:textColor="#F1F5F9"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2" />
    </ScrollView>

    <!-- Quick Action Chips (Horizontal Scroll) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_torch"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="🔦 Torch"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_battery"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="🔋 Battery"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_screenshot"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="📸 Screenshot"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_read_screen"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="📜 Read Screen"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_home"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="📱 Home"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_recents"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="⚡ Recents"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_scroll_down"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="⬇ Scroll Down"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_scroll_up"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="⬆ Scroll Up"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_vol_up"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="🔊 Vol +"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_vol_down"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="🔉 Vol -"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_mute"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="🔇 Mute"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_notifications"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="🔔 Notifications"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Voice-First Control Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Glowing Siri/Gemini-style Voice Button -->
        <TextView
            android:id="@+id/btn_hud_mic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎙 TAP TO SPEAK (Boliye)"
            android:textColor="#00F5FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_voice_mic_idle"
            android:clickable="true"
            android:focusable="true" />

        <!-- Quick Hide Button -->
        <TextView
            android:id="@+id/btn_hud_hide"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:text="▼"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
