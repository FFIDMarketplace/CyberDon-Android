<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CyberDon AI"
            android:textColor="#38BDF8"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jarvis Assistant for Ali"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAccessibilityStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accessibility: Checking..."
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvOverlayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appear on Top: Checking..."
                    android:textColor="#F8FAFC"
                    android:textSize="16sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetApiKey"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Set Gemini API Key (stored on this phone)"
            app:cornerRadius="12dp"
            android:backgroundTint="#334155"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnableAccessibility"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Enable Accessibility Service"
            app:cornerRadius="12dp"
            android:backgroundTint="#0284C7"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnableOverlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Enable Appear on Top"
            app:cornerRadius="12dp"
            android:backgroundTint="#334155"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetDefaultAssistant"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Set as Default Assistant (Bixby Slot)"
            app:cornerRadius="12dp"
            android:backgroundTint="#334155"
            android:layout_marginBottom="24dp" />

        <!-- Floating Mic Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeakNow"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="🎙️ Start hands-free voice session"
            android:textSize="18sp"
            app:cornerRadius="16dp"
            android:backgroundTint="#38BDF8"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="16dp"
            android:text="Ready for Ali's command..."
            android:textColor="#E2E8F0"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
